<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <!-- Gives the library the ASP.NET Core shared framework, which is what makes
       IHostApplicationBuilder, IEndpointRouteBuilder and the health-check types
       available without pulling them in as packages. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience"           Version="9.10.0" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery"          Version="9.5.2" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting"               Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol"   Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore"       Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http"             Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime"          Version="1.17.0" />
  </ItemGroup>

</Project>
