# Line endings and diff behaviour.
#
# This file used to be the stock Visual Studio template with every rule commented
# out — decoration rather than configuration. These are the rules that are actually
# in force.

# Normalise to LF in the repository, check out native on Windows.
* text=auto

# ── Source and configuration: always LF in the repo ──────────────────────────
*.cs        text diff=csharp
*.csproj    text
*.sln       text eol=crlf
*.props     text
*.targets   text
*.razor     text diff=html
*.cshtml    text diff=html
*.json      text
*.yml       text
*.yaml      text
*.toml      text
*.md        text diff=markdown
*.css       text
*.js        text
*.html      text diff=html

# ── Files whose line endings are not cosmetic ────────────────────────────────
# A shell script that reaches a Linux container with CRLF fails with the famously
# unhelpful "no such file or directory" — the interpreter path picks up the \r.
# These two rules are the reason this file stopped being decoration.
*.sh              text eol=lf
Dockerfile        text eol=lf
*.Dockerfile      text eol=lf
.dockerignore     text eol=lf
*.ps1             text eol=crlf

# ── Binary: never normalised, never diffed as text ───────────────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.ppm       binary
*.wasm      binary
*.dll       binary
*.pdb       binary

# ── Generated: collapsed in pull request diffs ───────────────────────────────
BlackHoleSim.Api/Migrations/** linguist-generated=true
*.Designer.cs                  linguist-generated=true
