# Copy this file to .env and adjust values before running docker compose up.
#
# Tiers:
#   required          must be set for the stack to run (defaults exist for local use)
#   optional          changes behaviour; safe to leave unset
#
# .env is gitignored. Nothing in it belongs in a commit — the deployed environments
# read the same values from platform secrets instead (see flyio/SECRETS.md).

# ── Database (required; the defaults are local-only) ─────────────────────────
POSTGRES_USER=blackhole
POSTGRES_PASSWORD=changeme
POSTGRES_DB=blackholesim

# ── Published host ports (optional) ──────────────────────────────────────────
# The port the Blazor frontend is served on.
WEB_PORT=8080
# The port the API is published on. The browser calls this address directly, so it
# also has to appear in the API's CORS allowlist — docker-compose.yml wires both
# from these two variables, which is why they are the single source of truth here.
API_PORT=5081
