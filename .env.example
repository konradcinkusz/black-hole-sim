# Copy this file to .env and adjust values before running docker compose up.
#
# Tiers:
#   required          must be set for the stack to run (defaults exist for local use)
#   optional          changes behaviour; safe to leave unset
#
# .env is gitignored. Nothing in it belongs in a commit — the deployed environments
# read the same values from platform secrets instead (see flyio/SECRETS.md).

# ── Database (required; the defaults are local-only) ─────────────────────────
POSTGRES_USER=blackhole
POSTGRES_PASSWORD=changeme
POSTGRES_DB=blackholesim

# The identity service's own logical database, on the same Postgres instance as the one
# above. It creates the database itself on first start; nothing else has to prepare it.
AUTH_POSTGRES_DB=authservice

# ── Identity service (required) ──────────────────────────────────────────────
# This deployment runs its own instance of konradcinkusz/authservice. Pin a real released
# tag; never float :latest. The tag must be one that signs with RS256 and publishes a JWKS
# (authservice ADR 0002) — an HS256-only build serves an empty key set and the API will
# reject every token it issues.
AUTH_IMAGE_TAG=v0.3.0

# The signing keypair lives in secrets/jwt-signing.pem (gitignored), generated by
# ./scripts/setup.sh. It is mounted into the identity service and never leaves it: the API
# holds no key material and validates against the published public half.

# ── Published host ports (optional) ──────────────────────────────────────────
# The port the Blazor frontend is served on.
WEB_PORT=8080
# The port the API is published on. The browser calls this address directly, so it
# also has to appear in the API's CORS allowlist — docker-compose.yml wires both
# from these two variables, which is why they are the single source of truth here.
API_PORT=5081
# The port the identity service is published on. Published for the same reason: the
# browser signs in against it directly, so it is a host address, not a container one.
AUTH_PORT=5083
