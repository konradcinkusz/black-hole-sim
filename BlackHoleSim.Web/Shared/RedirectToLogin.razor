@inject NavigationManager Navigation

@code {
    // Sends an unauthenticated visitor to the sign-in page, carrying where they were headed so
    // they land there afterwards rather than on the front page. forceLoad is deliberately off:
    // this is a client-side route, and reloading the bundle to reach it would discard the
    // navigation intent along with everything else.
    protected override void OnInitialized()
    {
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);

        Navigation.NavigateTo(
            string.IsNullOrEmpty(returnUrl) ? "login" : $"login?returnUrl={Uri.EscapeDataString(returnUrl)}",
            replace: true);
    }
}
