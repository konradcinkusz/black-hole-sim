<div class="nav-menu">
    <nav>
        <NavLink href="" Match="NavLinkMatch.All">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="8" />
                <path d="M9 15 L9 9 L15 12 Z" fill="currentColor" stroke="none" />
            </svg>
            <span>Render</span>
        </NavLink>
        <NavLink href="gallery">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="3" width="8" height="8" rx="1.5" />
                <rect x="13" y="3" width="8" height="8" rx="1.5" />
                <rect x="3" y="13" width="8" height="8" rx="1.5" />
                <rect x="13" y="13" width="8" height="8" rx="1.5" />
            </svg>
            <span>Gallery</span>
        </NavLink>
        <NavLink href="about">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 11v5.5" stroke-linecap="round" />
                <circle cx="12" cy="7.6" r="0.9" fill="currentColor" stroke="none" />
            </svg>
            <span>About</span>
        </NavLink>
    </nav>

    <div class="nav-account">
        <AuthorizeView>
            <Authorized>
                <span class="nav-account-name">@context.User.Identity?.Name</span>
                <button class="btn-small" @onclick="SignOutAsync">Sign out</button>
            </Authorized>
            <NotAuthorized>
                <NavLink href="login" class="btn-small">Sign in</NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    [Inject] AuthSession Session { get; set; } = default!;
    [Inject] NavigationManager Navigation { get; set; } = default!;

    private async Task SignOutAsync()
    {
        await Session.SignOutAsync();

        // Straight to the sign-in page rather than leaving the now-unauthorized page to redirect
        // itself, which would put the page just abandoned into the returnUrl.
        Navigation.NavigateTo("login");
    }
}
