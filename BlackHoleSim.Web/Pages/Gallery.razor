@page "/gallery"
@attribute [Authorize]

<PageTitle>Gallery — BlackHoleSim</PageTitle>

<h1>Render Gallery</h1>
<p class="subtitle">Your render jobs, newest first.</p>

@if (_loading)
{
    <p>Loading…</p>
}
else if (_jobs.Count == 0)
{
    <div class="card empty-state">
        <p>No renders yet. <a href="/">Start your first render!</a></p>
    </div>
}
else
{
    <div class="gallery-grid">
        @foreach (var job in _jobs)
        {
            <div class="gallery-card">
                @if (job.Status == RenderJobStatus.Completed && _images.TryGetValue(job.Id, out var image))
                {
                    <img src="@image" alt="Render @job.Id" class="gallery-thumb" />
                }
                else if (job.Status == RenderJobStatus.Completed)
                {
                    <div class="gallery-thumb gallery-placeholder">
                        <span class="hint">Loading…</span>
                    </div>
                }
                else
                {
                    <div class="gallery-thumb gallery-placeholder">
                        <span class="badge @job.Status.CssClass()">@job.Status</span>
                    </div>
                }
                <div class="gallery-meta">
                    <div class="gallery-meta-row">
                        <span class="job-id">@ShortId(job.Id)…</span>
                        <span>@job.Parameters.Width&times;@job.Parameters.Height</span>
                    </div>
                    <span class="job-date">@job.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                    <div class="gallery-actions">
                        @if (job.Status == RenderJobStatus.Completed
                             && _images.TryGetValue(job.Id, out var download))
                        {
                            <a href="@download" download="@($"blackhole_{ShortId(job.Id)}.png")"
                               class="btn-small">
                                Download
                            </a>
                        }
                        <button @onclick="() => DeleteAsync(job.Id)" class="btn-small btn-danger">
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="pagination">
        <button class="btn-small" @onclick="PrevPage" disabled="@(_page <= 1)">← Prev</button>
        <span>Page @_page</span>
        <button class="btn-small" @onclick="NextPage" disabled="@(_jobs.Count < _pageSize)">Next →</button>
    </div>
}

@code {
    [Inject] RenderApiClient Api { get; set; } = default!;

    private List<RenderJobDto> _jobs = [];

    // Thumbnails have to be fetched rather than linked: /api/jobs/{id}/image needs a bearer
    // token, and the browser sends none on an <img src>. Keyed by job so a page change or a
    // delete does not leave a card showing the previous render's picture.
    private readonly Dictionary<Guid, string> _images = [];

    private bool _loading = true;
    private int _page = 1;
    private const int _pageSize = 20;

    protected override async Task OnInitializedAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _jobs    = await Api.ListAsync(_page, _pageSize);
        _images.Clear();
        _loading = false;

        // After the grid is on screen, not before: the cards render immediately with a
        // placeholder and fill in as each image arrives, rather than the whole page waiting on
        // twenty downloads.
        await LoadImagesAsync();
    }

    private async Task LoadImagesAsync()
    {
        foreach (var job in _jobs.Where(j => j.Status == RenderJobStatus.Completed))
        {
            var image = await Api.GetImageDataUrlAsync(job.Id);

            // Sequential on purpose. Firing twenty concurrent requests at the API is a burst
            // that buys nothing here — the images are already rendered and waiting — and it is
            // the pattern most likely to trip a rate limiter for no user-visible gain.
            if (image is not null)
            {
                _images[job.Id] = image;
                StateHasChanged();
            }
        }
    }

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }

    private async Task DeleteAsync(Guid id)
    {
        await Api.DeleteAsync(id);
        await LoadAsync();
    }

    private static string ShortId(Guid id) => id.ToString("N").Substring(0, 8);
}
