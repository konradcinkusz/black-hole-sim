  <ItemGroup>
    <ProjectReference Include="..\BlackHoleSim.Api\BlackHoleSim.Api.csproj" />
    <ProjectReference Include="..\BlackHoleSim.Web\BlackHoleSim.Web.csproj" />
  </ItemGroup>

</Project>
